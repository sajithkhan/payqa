# Copy this file to .env and fill in your PayPal sandbox details.
# Get them free at https://developer.paypal.com (switch to Sandbox):
#   Apps & Credentials → Create App (Merchant, linked to a US sandbox business account)
#   Testing Tools → Sandbox Accounts → your US Personal account → View/edit (buyer login)

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox buyer account, used by Browser Mode to log into the PayPal popup
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Optional: Claude API key for AI analysis (https://platform.claude.com/settings/keys).
# Without it, PayQA shows built-in explanations.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default claude-sonnet-5-5; claude-haiku-5-5 is cheaper)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: false = watch Browser Mode in a visible Chrome window, true = run hidden (default)
PAYQA_HEADLESS=false
